# Guarded paths. Only the architect changes these paths.
#
# This file is the single source of truth for guarded paths:
# - GitHub uses it to request a review from the owner.
# - .claude/hooks/guard-paths.sh blocks agent edits to these paths.
# - check:guarded fails if a branch changes these paths.
#
# The hook and check:guarded read only entries that start with "/".
# An entry that ends with "/" guards a folder. Other entries guard one file.

/AGENTS.md          @aaskov
/CLAUDE.md          @aaskov
/README.md          @aaskov
/.copier-answers.yml  @aaskov
/mise.toml          @aaskov
/.mise/             @aaskov
/.claude/           @aaskov
/.githooks/         @aaskov
/.devcontainer/     @aaskov
/.github/           @aaskov
/contracts/         @aaskov
/docs/adr/          @aaskov
/tests/guardrails/  @aaskov

# Backend stack (docs/adr/0100): the dependencies, the checker configs, and the agent guide.
/backend/pyproject.toml   @aaskov
/backend/uv.lock          @aaskov
/backend/.python-version  @aaskov
/backend/AGENTS.md        @aaskov
/backend/CLAUDE.md        @aaskov
